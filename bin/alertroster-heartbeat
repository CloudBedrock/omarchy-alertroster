#!/bin/bash
# Dead-man's switch for anything on this machine.
#
#   alertroster-heartbeat expect nightly-backup 26h     # page me if it goes quiet
#   alertroster-heartbeat expect sync 10m --low
#   alertroster-heartbeat ping nightly-backup            # put this at the end of the job
#   alertroster-heartbeat forget nightly-backup
#   alertroster-heartbeat list
#   alertroster-heartbeat check                          # run by the plugin; pages for every beat gone overdue
#
# "expect" records how often a ping must arrive. "ping" touches the stamp.
# The plugin runs "check" on its refresh interval; "check" raises one page per
# beat that has gone overdue, once per lapse, through alertroster-page — so a
# lapsed heartbeat is a source of the receiver service like any other page,
# and lands on the shell only when no service is running.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/alertroster/heartbeats.json"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/alertroster/heartbeats"
mkdir -p "$(dirname "$CONFIG")" "$STATE"
[[ -f $CONFIG ]] || echo '{}' >"$CONFIG"

to_seconds() {
  local v="$1"
  case "$v" in
    *s) echo "${v%s}" ;;
    *m) echo $(( ${v%m} * 60 )) ;;
    *h) echo $(( ${v%h} * 3600 )) ;;
    *d) echo $(( ${v%d} * 86400 )) ;;
    *) echo "$v" ;;
  esac
}

cmd="${1:-}"; shift || true
case "$cmd" in
  expect)
    name="${1:?name}"; every="${2:?interval like 10m, 2h, 1d}"; shift 2
    urgency="high"; [[ ${1:-} == "--low" ]] && urgency="low"
    secs=$(to_seconds "$every")
    tmp=$(mktemp)
    jq --arg n "$name" --argjson s "$secs" --arg u "$urgency" \
      '.[$n] = {every: $s, urgency: $u}' "$CONFIG" >"$tmp" && mv "$tmp" "$CONFIG"
    touch "$STATE/$name"
    echo "Expecting a ping from '$name' every $every."
    ;;
  ping)
    name="${1:?name}"
    touch "$STATE/$name"
    rm -f "$STATE/$name.paged"
    ;;
  forget)
    name="${1:?name}"
    tmp=$(mktemp)
    jq --arg n "$name" 'del(.[$n])' "$CONFIG" >"$tmp" && mv "$tmp" "$CONFIG"
    rm -f "$STATE/$name" "$STATE/$name.paged"
    ;;
  list)
    now=$(date +%s)
    jq -r 'to_entries[] | "\(.key)\t\(.value.every)\t\(.value.urgency)"' "$CONFIG" | while IFS=$'\t' read -r n every u; do
      if [[ -f $STATE/$n ]]; then
        age=$(( now - $(stat -c %Y "$STATE/$n") ))
        printf '%-24s every %6ss  last ping %6ss ago  %s\n' "$n" "$every" "$age" "$u"
      else
        printf '%-24s every %6ss  never pinged  %s\n' "$n" "$every" "$u"
      fi
    done
    ;;
  check)
    now=$(date +%s)
    while IFS=$'\t' read -r n every u; do
      [[ -n $n ]] || continue
      stamp="$STATE/$n"
      last=0; [[ -f $stamp ]] && last=$(stat -c %Y "$stamp")
      if (( now - last > every )) && [[ ! -f $stamp.paged ]]; then
        touch "$stamp.paged"
        silent=$(( now - last ))
        if (( silent >= 172800 )); then ago="$(( silent / 86400 ))d"
        elif (( silent >= 3600 )); then ago="$(( silent / 3600 ))h $(( silent % 3600 / 60 ))m"
        elif (( silent >= 60 )); then ago="$(( silent / 60 ))m"
        else ago="${silent}s"; fi
        [[ $last == 0 ]] && ago="ever"
        flag=(); [[ $u == low ]] && flag=(--low)
        "$BIN_DIR/alertroster-page" "${flag[@]}" --source heartbeat --dedup "heartbeat:$n" \
          --detail "Expected a ping every ${every}s. Clear it with: alertroster-heartbeat ping $n" \
          "No heartbeat from $n for $ago" || true
      fi
    done < <(jq -r 'to_entries[] | "\(.key)\t\(.value.every)\t\(.value.urgency)"' "$CONFIG")
    ;;
  *)
    sed -n '2,15p' "$0"; exit 2 ;;
esac
