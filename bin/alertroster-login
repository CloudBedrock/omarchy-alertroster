#!/bin/bash
# Sign this machine in to AlertRoster. Email-first, like the apps: you get a
# one-time code by email, paste it here, and the tokens go into the system
# keyring. Nothing is written to disk in the clear.
#
#   alertroster-login                      # https://alertroster.com
#   alertroster-login --host https://ar.example.com
#   alertroster-login --sync-key ark_sync_…   # lets alertroster-page --remote raise incidents
#   alertroster-login --logout

set -euo pipefail

SERVICE="alertroster"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/alertroster"
HOST_FILE="$CONFIG_DIR/host"
mkdir -p "$CONFIG_DIR"

host="https://alertroster.com"
[[ -f $HOST_FILE ]] && host="$(<"$HOST_FILE")"

while (( $# > 0 )); do
  case "$1" in
    --host) host="${2:?--host needs a URL}"; shift 2 ;;
    --sync-key)
      key="${2:?--sync-key needs an ark_sync_ key}"
      [[ $key == ark_sync_* ]] || { echo "that is not a sync integration key (ark_sync_…)" >&2; exit 2; }
      printf %s "$key" | secret-tool store --label "AlertRoster integration key" service "$SERVICE" kind sync-key
      echo "Integration key stored. alertroster-page --remote will raise incidents on that source."
      exit 0 ;;
    --logout)
      secret-tool clear service "$SERVICE" kind access 2>/dev/null || true
      secret-tool clear service "$SERVICE" kind refresh 2>/dev/null || true
      secret-tool clear service "$SERVICE" kind sync-key 2>/dev/null || true
      omarchy-shell alertroster.pager refresh >/dev/null 2>&1 || true
      echo "Signed out."
      exit 0 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

host="${host%/}"
printf %s "$host" >"$HOST_FILE"

read -rp "Email: " email
[[ -n $email ]] || exit 1

curl -fsS --max-time 10 -X POST "$host/api/v1/auth/request_link" \
  -H "Content-Type: application/json" \
  --data "$(jq -cn --arg e "$email" '{email:$e}')" >/dev/null
echo "If that address is on a roster, a sign-in code is on its way."

read -rp "Code from the email: " code
[[ -n $code ]] || exit 1

out=$(curl -fsS --max-time 10 -X POST "$host/api/v1/auth/login" \
  -H "Content-Type: application/json" \
  --data "$(jq -cn --arg e "$email" --arg c "$code" '{email:$e, code:$c}')") || {
  echo "Sign-in refused." >&2; exit 1; }

access=$(jq -r '.access_token // empty' <<<"$out")
refresh=$(jq -r '.refresh_token // empty' <<<"$out")
[[ -n $access && -n $refresh ]] || { echo "Unexpected response from $host" >&2; exit 1; }

printf %s "$access"  | secret-tool store --label "AlertRoster access"  service "$SERVICE" kind access
printf %s "$refresh" | secret-tool store --label "AlertRoster refresh" service "$SERVICE" kind refresh

account=$(jq -r '.account.name // .account.slug // "your account"' <<<"$out")
echo "Signed in to $account on $host."
omarchy-shell alertroster.pager refresh >/dev/null 2>&1 || true
